# Allura Ecosystem — Environment Variable Schema
#
# This file declares the environment variables used by the project. It is
# SAFE to commit — it contains no secrets, only variable names and docs.
#
# Per varlock policy (.opencode/policy/varlock skill + .opencode/GOVERNANCE.md):
#   - Secrets NEVER appear in terminal output, logs, traces, git diffs, or context
#   - Real values live in .env (gitignored) or in the shell environment
#   - opencode.jsonc uses {env:VAR_NAME} substitution to reference them
#
# To get values:
#   FAL_KEY     — https://fal.ai/dashboard/keys
#   BW_SESSION  — `bw login` then `bw unlock --raw`
#   CF_ACCESS_CLIENT_ID     — Cloudflare Access service token (already created: openclaw-allura)
#   CF_ACCESS_CLIENT_SECRET — Cloudflare Access service token secret (shown at creation time)

# fal.ai MCP server — remote at https://mcp.fal.ai/mcp
# Used by: opencode.jsonc → mcp.fal-ai.headers.Authorization = "Bearer {env:FAL_KEY}"
# Scope: fal model runs (image/video/audio/3D). Stateless. Per-request auth.
FAL_KEY=

# Bitwarden MCP server — local via npx @bitwarden/mcp-server
# Used by: opencode.jsonc → mcp.bitwarden.environment.BW_SESSION = "{env:BW_SESSION}"
# Scope: vault item retrieval, send creation, org admin. Session token from `bw unlock --raw`.
# Rotate: expires when session locks; re-run `bw unlock --raw` to refresh.
BW_SESSION=

# Optional — Bitwarden Organization Administration (API credentials)
# Only needed if you use org admin tools (members, groups, policies, events).
# Get from: Bitwarden Web Vault → organization → Settings → My Organization → API Key
BW_CLIENT_ID=
BW_CLIENT_SECRET=

# Cloudflare Access service token for mcp.faithmeats.org tunnel
# Used by: opencode.json → mcp.allura-brain.headers (CF-Access-Client-Id/Secret)
# The Allura Brain MCP is routed through the Cloudflare laptop tunnel (mcp.faithmeats.org).
# The tunnel is protected by Cloudflare Access with a service token policy (non_identity).
# Token name: openclaw-allura, created 2026-06-28, expires 2036-06-25.
# Get from: Cloudflare Zero Trust dashboard → Access → Service Tokens
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=